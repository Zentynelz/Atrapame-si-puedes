<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tron_dark_bg">

    <!-- Game Board (Background layer) -->
    <com.equipo.atrapame.presentation.game.IsometricBoardView
        android:id="@+id/gameBoard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/tron_grid_bg"
        android:contentDescription="@string/game_board_content_description"
        android:importantForAccessibility="yes"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HUD Top Left: Moves -->
    <TextView
        android:id="@+id/tvMoves"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/moves_initial"
        style="@style/TronTextStats"
        android:textSize="20sp"
        android:shadowColor="@color/tron_cyan_glow"
        android:shadowRadius="12"
        android:shadowDx="1"
        android:shadowDy="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- HUD Top Right: Time -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/time_initial"
        style="@style/TronTextStats"
        android:textSize="20sp"
        android:shadowColor="@color/tron_cyan_glow"
        android:shadowRadius="12"
        android:shadowDx="1"
        android:shadowDy="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvGameStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tron_panel_bg"
        android:padding="24dp"
        android:text="@string/loading"
        style="@style/TronTextTitle"
        android:textSize="24sp"
        android:shadowColor="@color/tron_cyan_glow"
        android:shadowRadius="15"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Left HUD: Joystick -->
    <com.equipo.atrapame.presentation.game.VirtualDPadView
        android:id="@+id/joystick"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:elevation="4dp"
        android:alpha="0.85"
        android:contentDescription="@string/joystick_content_description"
        android:importantForAccessibility="yes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Right HUD: Buttons -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPause"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_pause"
            style="@style/GameButton"
            android:strokeColor="@color/tron_orange"
            android:textColor="@color/tron_orange" />

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="@string/btn_restart"
            style="@style/GameButton" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>